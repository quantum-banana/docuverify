# Safe local defaults. Copy to .env; never commit the resulting file.
DOCUVERIFY_ENV=development
DOCUVERIFY_BACKEND_HOST=127.0.0.1
DOCUVERIFY_BACKEND_PORT=8000
DOCUVERIFY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Runtime files remain local and are excluded by .gitignore.
DOCUVERIFY_RUNTIME_DIR=runtime
DOCUVERIFY_MAX_UPLOAD_MB=15
DOCUVERIFY_RETENTION_HOURS=24
DOCUVERIFY_CLEANUP_INTERVAL_SECONDS=300
DOCUVERIFY_WORKERS=2
DOCUVERIFY_MAX_RENDER_DIMENSION=1800
DOCUVERIFY_MAX_PAGES=10

# Phase 2 uses reliable embedded PDF text first and cached RapidOCR/ONNX Runtime
# for raster-only pages. CPU is the verified default; do not claim GPU unless
# diagnostics reports a supported GPU execution provider.
DOCUVERIFY_OCR_PROVIDER=auto
DOCUVERIFY_OCR_DEVICE=cpu

# Optional detached official-source metadata/profile root. It is read-only.
# The application always loads its bundled validated profiles as a baseline.
DOCUVAULT_PATH=

# Explicit PDF-signature roots only. Never falls back to the OS TLS root store.
# Certificate files remain local and are ignored by Git.
DOCUVERIFY_TRUST_STORE=backend/docuvault/trust-store

# Empty means same-origin requests. run-local.ps1 sets the proxy target to the
# selected backend address and port; this default also supports `npm run dev`.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
