{
  "$defs": {
    "AssetLinks": {
      "additionalProperties": false,
      "properties": {
        "candidate_crop_url": {
          "title": "Candidate Crop Url",
          "type": "string"
        },
        "difference_overlay_url": {
          "title": "Difference Overlay Url",
          "type": "string"
        },
        "reference_crop_url": {
          "title": "Reference Crop Url",
          "type": "string"
        }
      },
      "required": [
        "candidate_crop_url",
        "reference_crop_url",
        "difference_overlay_url"
      ],
      "title": "AssetLinks",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Candidate-page coordinates normalized to [0, 1].",
      "properties": {
        "height": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "$ref": "#/$defs/AssetLinks"
        },
        "bounding_box": {
          "$ref": "#/$defs/BoundingBox"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence_source": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Source",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "region_role": {
          "$ref": "#/$defs/RegionRole",
          "default": "unknown"
        },
        "risk_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "supporting_measurements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Supporting Measurements",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "page_number",
        "category",
        "title",
        "explanation",
        "bounding_box",
        "risk_score",
        "confidence_score",
        "severity",
        "evidence_source",
        "assets"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PageOCRSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Candidate Characters",
          "type": "integer"
        },
        "candidate_confidence": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Confidence"
        },
        "candidate_device": {
          "default": "cpu",
          "title": "Candidate Device",
          "type": "string"
        },
        "candidate_provider": {
          "title": "Candidate Provider",
          "type": "string"
        },
        "candidate_succeeded": {
          "default": false,
          "title": "Candidate Succeeded",
          "type": "boolean"
        },
        "reference_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Reference Characters",
          "type": "integer"
        },
        "reference_confidence": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Confidence"
        },
        "reference_device": {
          "default": "cpu",
          "title": "Reference Device",
          "type": "string"
        },
        "reference_provider": {
          "title": "Reference Provider",
          "type": "string"
        },
        "reference_succeeded": {
          "default": false,
          "title": "Reference Succeeded",
          "type": "boolean"
        }
      },
      "required": [
        "reference_provider",
        "candidate_provider"
      ],
      "title": "PageOCRSummary",
      "type": "object"
    },
    "PageStatus": {
      "enum": [
        "matched",
        "reordered",
        "missing",
        "added",
        "failed"
      ],
      "title": "PageStatus",
      "type": "string"
    },
    "RegionRole": {
      "enum": [
        "fixed",
        "variable",
        "unknown"
      ],
      "title": "RegionRole",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://docuverify.local/schemas/v1/page-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alignment_quality": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Alignment Quality",
      "type": "number"
    },
    "candidate_image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Image Url"
    },
    "candidate_page_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Page Number"
    },
    "confidence_score": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Confidence Score",
      "type": "number"
    },
    "coverage_score": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Coverage Score",
      "type": "number"
    },
    "finding_count": {
      "default": 0,
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "ocr": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageOCRSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "reference_image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reference Image Url"
    },
    "reference_page_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Page Number"
    },
    "risk_score": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Risk Score",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/PageStatus",
      "default": "matched"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "page_number",
    "width",
    "height",
    "reference_image_url",
    "candidate_image_url",
    "findings"
  ],
  "title": "PageResult",
  "type": "object"
}
