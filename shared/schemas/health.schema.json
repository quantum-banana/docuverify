        },
        "embedded_pdf_text": {
          "title": "Embedded Pdf Text",
          "type": "boolean"
        },
        "handwriting_comparison": {
          "default": false,
          "title": "Handwriting Comparison",
          "type": "boolean"
        },
        "image_rendering": {
          "title": "Image Rendering",
          "type": "boolean"
        },
        "logical_rules": {
          "default": false,
          "title": "Logical Rules",
          "type": "boolean"
        },
        "metadata_forensics": {
          "default": false,
          "title": "Metadata Forensics",
          "type": "boolean"
        },
        "multi_page": {
          "default": true,
          "title": "Multi Page",
          "type": "boolean"
        },
        "pdf_rendering": {
          "title": "Pdf Rendering",
          "type": "boolean"
        },
        "pdf_signature_validation": {
          "default": false,
          "title": "Pdf Signature Validation",
