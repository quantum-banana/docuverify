{
  "$defs": {
    "AssetLinks": {
      "additionalProperties": false,
      "properties": {
        "candidate_crop_url": {
          "title": "Candidate Crop Url",
          "type": "string"
        },
        "difference_overlay_url": {
          "title": "Difference Overlay Url",
          "type": "string"
        },
        "reference_crop_url": {
          "title": "Reference Crop Url",
          "type": "string"
        }
      },
      "required": [
        "candidate_crop_url",
        "reference_crop_url",
        "difference_overlay_url"
      ],
      "title": "AssetLinks",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Candidate-page coordinates normalized to [0, 1].",
      "properties": {
        "height": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ComparisonMode": {
      "enum": [
        "exact",
        "template"
      ],
      "title": "ComparisonMode",
      "type": "string"
    },
    "CoordinateTransform": {
      "additionalProperties": false,
      "properties": {
        "normalized_height": {
          "exclusiveMinimum": 0,
          "title": "Normalized Height",
          "type": "integer"
        },
        "normalized_width": {
          "exclusiveMinimum": 0,
          "title": "Normalized Width",
          "type": "integer"
        },
        "orientation_degrees": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Orientation Degrees",
          "type": "integer"
        },
        "original_height": {
          "exclusiveMinimum": 0,
          "title": "Original Height",
          "type": "integer"
        },
        "original_width": {
          "exclusiveMinimum": 0,
          "title": "Original Width",
          "type": "integer"
        },
        "scale_x": {
          "exclusiveMinimum": 0,
          "title": "Scale X",
          "type": "number"
        },
        "scale_y": {
          "exclusiveMinimum": 0,
          "title": "Scale Y",
          "type": "number"
        }
      },
      "required": [
        "original_width",
        "original_height",
        "normalized_width",
        "normalized_height",
        "scale_x",
        "scale_y"
      ],
      "title": "CoordinateTransform",
      "type": "object"
    },
    "DocumentAggregate": {
      "additionalProperties": false,
      "properties": {
        "added_page_count": {
          "minimum": 0,
          "title": "Added Page Count",
          "type": "integer"
        },
        "alignment_quality": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Alignment Quality",
          "type": "number"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "coverage_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Coverage Score",
          "type": "number"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "matched_page_count": {
          "minimum": 0,
          "title": "Matched Page Count",
          "type": "integer"
        },
        "missing_page_count": {
          "minimum": 0,
          "title": "Missing Page Count",
          "type": "integer"
        },
        "reordered_page_count": {
          "minimum": 0,
          "title": "Reordered Page Count",
          "type": "integer"
        },
        "risk_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        }
      },
      "required": [
        "risk_score",
        "confidence_score",
        "coverage_score",
        "alignment_quality",
        "finding_count",
        "matched_page_count",
        "missing_page_count",
        "added_page_count",
        "reordered_page_count"
      ],
      "title": "DocumentAggregate",
      "type": "object"
    },
    "DocumentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "page_count": {
          "maximum": 10,
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "preview_url": {
          "title": "Preview Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/CoordinateTransform"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "content_type",
        "sha256",
        "page_count",
        "width",
        "height",
        "preview_url",
        "transform"
      ],
      "title": "DocumentDescriptor",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "$ref": "#/$defs/AssetLinks"
        },
        "bounding_box": {
          "$ref": "#/$defs/BoundingBox"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence_source": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Source",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "region_role": {
          "$ref": "#/$defs/RegionRole",
          "default": "unknown"
        },
        "risk_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "supporting_measurements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Supporting Measurements",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "page_number",
        "category",
        "title",
        "explanation",
        "bounding_box",
        "risk_score",
        "confidence_score",
        "severity",
        "evidence_source",
        "assets"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PageAnomalyType": {
      "enum": [
        "page_missing",
        "page_added",
        "page_reordered",
        "page_dimension_mismatch"
      ],
      "title": "PageAnomalyType",
      "type": "string"
    },
    "PageCorrespondence": {
      "additionalProperties": false,
      "properties": {
        "candidate_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Page Number"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "dimension_similarity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension Similarity"
        },
        "heading_similarity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Similarity"
        },
        "perceptual_similarity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceptual Similarity"
        },
        "reference_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Page Number"
        },
        "status": {
          "$ref": "#/$defs/PageStatus"
        }
      },
      "required": [
        "status",
        "confidence_score"
      ],
      "title": "PageCorrespondence",
      "type": "object"
    },
    "PageOCRSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Candidate Characters",
          "type": "integer"
        },
        "candidate_confidence": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Confidence"
        },
        "candidate_device": {
          "default": "cpu",
          "title": "Candidate Device",
          "type": "string"
        },
        "candidate_provider": {
          "title": "Candidate Provider",
          "type": "string"
        },
        "candidate_succeeded": {
          "default": false,
          "title": "Candidate Succeeded",
          "type": "boolean"
        },
        "reference_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Reference Characters",
          "type": "integer"
        },
        "reference_confidence": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Confidence"
        },
        "reference_device": {
          "default": "cpu",
          "title": "Reference Device",
          "type": "string"
        },
        "reference_provider": {
          "title": "Reference Provider",
          "type": "string"
        },
        "reference_succeeded": {
          "default": false,
          "title": "Reference Succeeded",
          "type": "boolean"
        }
      },
      "required": [
        "reference_provider",
        "candidate_provider"
      ],
      "title": "PageOCRSummary",
      "type": "object"
    },
    "PageOrderAnomaly": {
      "additionalProperties": false,
      "properties": {
        "anomaly_id": {
          "title": "Anomaly Id",
          "type": "string"
        },
        "anomaly_type": {
          "$ref": "#/$defs/PageAnomalyType"
        },
        "candidate_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Page Number"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "reference_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Page Number"
        },
        "risk_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "anomaly_id",
        "anomaly_type",
        "title",
        "explanation",
        "risk_score",
        "confidence_score"
      ],
      "title": "PageOrderAnomaly",
      "type": "object"
    },
    "PageResult": {
      "additionalProperties": false,
      "properties": {
        "alignment_quality": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Alignment Quality",
          "type": "number"
        },
        "candidate_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Image Url"
        },
        "candidate_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Page Number"
        },
        "confidence_score": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "coverage_score": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Coverage Score",
          "type": "number"
        },
        "finding_count": {
          "default": 0,
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "ocr": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageOCRSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "reference_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Image Url"
        },
        "reference_page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Page Number"
        },
        "risk_score": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/PageStatus",
          "default": "matched"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "width",
        "height",
        "reference_image_url",
        "candidate_image_url",
        "findings"
      ],
      "title": "PageResult",
      "type": "object"
    },
    "PageStatus": {
      "enum": [
        "matched",
        "reordered",
        "missing",
        "added",
        "failed"
      ],
      "title": "PageStatus",
      "type": "string"
    },
    "RegionRole": {
      "enum": [
        "fixed",
        "variable",
        "unknown"
      ],
      "title": "RegionRole",
      "type": "string"
    },
    "RegionSuggestion": {
      "additionalProperties": false,
      "properties": {
        "bounding_box": {
          "$ref": "#/$defs/BoundingBox"
        },
        "confidence_score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/RegionRole"
        },
        "suggestion_id": {
          "title": "Suggestion Id",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "page_number",
        "bounding_box",
        "role",
        "confidence_score",
        "reason"
      ],
      "title": "RegionSuggestion",
      "type": "object"
    },
    "RiskLabel": {
      "enum": [
        "Low tampering risk",
        "Moderate tampering risk",
        "High tampering risk",
        "Critical tampering risk"
      ],
      "title": "RiskLabel",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TextExtractionSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_characters": {
          "minimum": 0,
          "title": "Candidate Characters",
          "type": "integer"
        },
        "candidate_source": {
          "title": "Candidate Source",
          "type": "string"
        },
        "reference_characters": {
          "minimum": 0,
          "title": "Reference Characters",
          "type": "integer"
        },
        "reference_source": {
          "title": "Reference Source",
          "type": "string"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Similarity"
        }
      },
      "required": [
        "reference_source",
        "candidate_source",
        "reference_characters",
        "candidate_characters",
        "similarity"
      ],
      "title": "TextExtractionSummary",
      "type": "object"
    }
  },
  "$id": "https://docuverify.local/schemas/v1/document-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alignment_quality": {
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Alignment Quality",
      "type": "number"
    },
    "analysis_coverage": {
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Analysis Coverage",
      "type": "number"
    },
    "assessment_confidence": {
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Assessment Confidence",
      "type": "number"
    },
    "candidate": {
      "$ref": "#/$defs/DocumentDescriptor"
    },
    "candidate_page_count": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Candidate Page Count",
      "type": "integer"
    },
    "comparison_mode": {
      "$ref": "#/$defs/ComparisonMode",
      "default": "exact"
    },
    "document_aggregate": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentAggregate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "overall_tampering_risk": {
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Overall Tampering Risk",
      "type": "number"
    },
    "page_correspondence": {
      "items": {
        "$ref": "#/$defs/PageCorrespondence"
      },
      "title": "Page Correspondence",
      "type": "array"
    },
    "page_order_anomalies": {
      "items": {
        "$ref": "#/$defs/PageOrderAnomaly"
      },
      "title": "Page Order Anomalies",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageResult"
      },
      "title": "Pages",
      "type": "array"
    },
    "processing_duration_ms": {
      "minimum": 0,
      "title": "Processing Duration Ms",
      "type": "integer"
    },
    "reference": {
      "$ref": "#/$defs/DocumentDescriptor"
    },
    "reference_page_count": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Reference Page Count",
      "type": "integer"
    },
    "region_suggestions": {
      "items": {
        "$ref": "#/$defs/RegionSuggestion"
      },
      "title": "Region Suggestions",
      "type": "array"
    },
    "risk_label": {
      "$ref": "#/$defs/RiskLabel"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text_extraction": {
      "$ref": "#/$defs/TextExtractionSummary"
    },
    "total_page_count": {
      "default": 1,
      "description": "Number of ordered review slots in pages/page_correspondence; reference and candidate physical page counts remain capped at ten each.",
      "maximum": 20,
      "minimum": 1,
      "title": "Total Page Count",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "reference",
    "candidate",
    "pages",
    "overall_tampering_risk",
    "risk_label",
    "assessment_confidence",
    "analysis_coverage",
    "alignment_quality",
    "finding_count",
    "processing_duration_ms",
    "text_extraction",
    "generated_at"
  ],
  "title": "DocumentResult",
  "type": "object"
}
