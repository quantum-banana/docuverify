{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docuverify.local/schemas/docuvault/profile.v1.schema.json",
  "title": "DocuVerify trusted document profile 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "issuer", "jurisdiction", "document_family",
    "subtype", "version", "validity", "languages", "scripts", "supported_formats",
    "expected_pages", "stable_headings", "stable_labels", "keywords", "regions",
    "fields", "security_regions", "layout_anchors", "typography", "logical_rules",
    "digital_signature", "codes", "source", "provenance", "profile_confidence",
    "completeness", "known_limitations", "capability_tier", "reference_assets", "enabled"
  ],
  "allOf": [
    {
      "if": { "properties": { "capability_tier": { "const": "visual_reference" } } },
      "then": { "properties": { "reference_assets": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "capability_tier": { "enum": ["metadata_only", "structural"] } } },
      "then": { "properties": { "reference_assets": { "maxItems": 0 } } }
    }
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "$ref": "#/$defs/id" },
    "display_name": { "$ref": "#/$defs/text" },
    "issuer": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "aliases"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "aliases": { "$ref": "#/$defs/textArray" }
      }
    },
    "jurisdiction": {
      "type": "object", "additionalProperties": false, "required": ["country", "state"],
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "state": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 }
      }
    },
    "document_family": { "$ref": "#/$defs/id" },
    "subtype": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/text" },
    "validity": {
      "type": "object", "additionalProperties": false,
      "required": ["from_year", "to_year", "notes"],
      "properties": {
        "from_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "to_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "notes": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "languages": { "$ref": "#/$defs/textArrayNonEmpty" },
    "scripts": { "$ref": "#/$defs/textArrayNonEmpty" },
    "supported_formats": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["pdf", "png", "jpeg"] }
    },
    "expected_pages": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "maximum", "orientation", "dimensions"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 10 },
        "orientation": { "enum": ["portrait", "landscape", "either"] },
        "dimensions": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["width", "height", "unit", "tolerance"],
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "enum": ["points", "pixels", "millimetres"] },
              "tolerance": { "type": "number", "minimum": 0, "maximum": 0.5 }
            }
          }
        }
      }
    },
    "stable_headings": { "$ref": "#/$defs/textArray" },
    "stable_labels": { "$ref": "#/$defs/textArray" },
    "keywords": { "$ref": "#/$defs/textArrayNonEmpty" },
    "regions": {
      "type": "object", "additionalProperties": false, "required": ["fixed", "variable", "unknown"],
      "properties": {
        "fixed": { "$ref": "#/$defs/regions" },
        "variable": { "$ref": "#/$defs/regions" },
        "unknown": { "$ref": "#/$defs/regions" }
      }
    },
    "fields": {
      "type": "array", "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field_id", "labels", "format", "page", "sensitive", "required"],
        "properties": {
          "field_id": { "$ref": "#/$defs/id" },
          "labels": { "$ref": "#/$defs/textArrayNonEmpty" },
          "format": { "type": ["string", "null"], "maxLength": 500 },
          "page": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
          "sensitive": { "type": "boolean" },
          "required": { "type": "boolean" }
        }
      }
    },
    "security_regions": {
      "type": "object", "additionalProperties": false,
      "required": ["logo", "seal", "photo", "signature", "handwriting", "qr", "barcode"],
      "properties": {
        "logo": { "$ref": "#/$defs/regions" },
        "seal": { "$ref": "#/$defs/regions" },
        "photo": { "$ref": "#/$defs/regions" },
        "signature": { "$ref": "#/$defs/regions" },
        "handwriting": { "$ref": "#/$defs/regions" },
        "qr": { "$ref": "#/$defs/regions" },
        "barcode": { "$ref": "#/$defs/regions" }
      }
    },
    "layout_anchors": {
      "type": "array", "maxItems": 60,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anchor_id", "text", "page", "box", "tolerance"],
        "properties": {
          "anchor_id": { "$ref": "#/$defs/id" },
          "text": { "$ref": "#/$defs/text" },
          "page": { "type": "integer", "minimum": 1, "maximum": 10 },
          "box": { "$ref": "#/$defs/box" },
          "tolerance": { "type": "number", "minimum": 0, "maximum": 0.5 }
        }
      }
    },
    "typography": {
      "type": "object", "additionalProperties": false,
      "required": ["weight", "case", "alignment", "appearance_descriptors"],
      "properties": {
        "weight": { "enum": ["light", "regular", "medium", "bold", "mixed", "unknown"] },
        "case": { "enum": ["upper", "lower", "title", "mixed", "unknown"] },
        "alignment": { "enum": ["left", "center", "right", "mixed", "unknown"] },
        "appearance_descriptors": { "$ref": "#/$defs/textArray" }
      }
    },
    "logical_rules": {
      "type": "array", "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "version", "type", "fields", "parameters", "minimum_ocr_confidence", "explanation"],
        "properties": {
          "rule_id": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "type": {
            "enum": ["sum_equals", "percentage_matches", "grade_range", "numeric_range", "status_consistency", "date_order", "age_consistency", "cross_page_equal", "regex", "qr_equals", "fixed_text_present"]
          },
          "fields": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "parameters": { "type": "object", "maxProperties": 30 },
          "minimum_ocr_confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "explanation": { "$ref": "#/$defs/text" }
        }
      }
    },
    "digital_signature": {
      "type": "object", "additionalProperties": false,
      "required": ["expectation", "trusted_issuer_ids", "allowed_formats"],
      "properties": {
        "expectation": { "enum": ["required", "optional", "not_expected", "unknown"] },
        "trusted_issuer_ids": { "$ref": "#/$defs/textArray" },
        "allowed_formats": { "$ref": "#/$defs/textArray" }
      }
    },
    "codes": {
      "type": "object", "additionalProperties": false,
      "required": ["qr_expectation", "barcode_expectation", "payload_format", "required_keys", "issuer_prefixes", "cryptographic_specification"],
      "properties": {
        "qr_expectation": { "enum": ["required", "optional", "not_expected", "unknown"] },
        "barcode_expectation": { "enum": ["required", "optional", "not_expected", "unknown"] },
        "payload_format": { "enum": ["json", "query", "xml", "text", "issuer_specific", "unknown"] },
        "required_keys": { "$ref": "#/$defs/textArray" },
        "issuer_prefixes": { "$ref": "#/$defs/textArray" },
        "cryptographic_specification": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "authoritative_url", "retrieved_at", "sha256", "format", "redistribution_status", "licence"],
      "properties": {
        "record_id": { "type": ["string", "null"], "maxLength": 200 },
        "authoritative_url": { "type": ["string", "null"], "format": "uri", "maxLength": 4000 },
        "retrieved_at": { "type": "string", "format": "date" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["metadata", "pdf", "png", "jpeg", "synthetic"] },
        "redistribution_status": { "enum": ["permitted", "not_permitted", "unclear", "not_applicable"] },
        "licence": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "assurance", "description"],
      "properties": {
        "kind": { "enum": ["authoritative", "authoritative_metadata", "structurally_derived_authoritative", "synthetic_showcase", "generic_family"] },
        "assurance": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "profile_confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "completeness": { "type": "number", "minimum": 0, "maximum": 100 },
    "known_limitations": { "$ref": "#/$defs/textArrayNonEmpty" },
    "capability_tier": {
      "enum": ["metadata_only", "structural", "visual_reference", "cryptographic"]
    },
    "reference_assets": {
      "type": "array", "maxItems": 20,
      "items": { "$ref": "#/$defs/referenceAsset" }
    },
    "visual_reference": {
      "description": "Deprecated compatibility metadata; reference_assets is authoritative.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["relative_path", "sha256", "format", "provenance"],
          "properties": {
            "relative_path": { "type": "string", "pattern": "^(samples/synthetic|backend/docuvault/references)/[A-Za-z0-9._/-]+$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "format": { "enum": ["pdf", "png", "jpeg"] },
            "provenance": { "enum": ["authoritative", "synthetic_showcase"] }
          }
        }
      ]
    },
    "enabled": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*" },
    "textArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "textArrayNonEmpty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "box": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "page", "box", "label"],
      "properties": {
        "region_id": { "$ref": "#/$defs/id" },
        "page": { "type": "integer", "minimum": 1, "maximum": 10 },
        "box": { "$ref": "#/$defs/box" },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "regions": { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/region" } },
    "regionsNonEmpty": {
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": { "$ref": "#/$defs/region" }
    },
    "securityElementRegions": {
      "type": "object", "additionalProperties": false,
      "required": ["logo", "seal", "photo", "signature", "handwriting", "qr", "barcode"],
      "properties": {
        "logo": { "$ref": "#/$defs/regions" },
        "seal": { "$ref": "#/$defs/regions" },
        "photo": { "$ref": "#/$defs/regions" },
        "signature": { "$ref": "#/$defs/regions" },
        "handwriting": { "$ref": "#/$defs/regions" },
        "qr": { "$ref": "#/$defs/regions" },
        "barcode": { "$ref": "#/$defs/regions" },
        "mrz": { "$ref": "#/$defs/regions" },
        "document_number": { "$ref": "#/$defs/regions" },
        "hologram": { "$ref": "#/$defs/regions" }
      }
    },
    "assetPath": {
      "type": "string",
      "pattern": "^(backend/docuvault/assets/synthetic|backend/docuvault/references|samples/synthetic|references|thumbnails|masks|fingerprints)/[A-Za-z0-9._/-]+$"
    },
    "binaryAssetDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "mime_type", "sha256", "width", "height"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/assetPath" },
        "mime_type": { "enum": ["image/png", "image/webp", "image/jpeg"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "fingerprintFileDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "mime_type", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/assetPath" },
        "mime_type": { "const": "application/json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "referenceAsset": {
      "type": "object", "additionalProperties": false,
      "required": [
        "asset_id", "profile_id", "exemplar_id", "document_page_number",
        "asset_page_number", "side", "relative_path", "mime_type", "sha256",
        "dimensions", "source_class", "trust_level", "issuer", "document_family",
        "profile_version", "languages", "creation_method", "source_url",
        "retrieval_date", "redistribution_status", "licence_status_note",
        "may_influence_tampering_risk", "demonstration_only", "enabled",
        "thumbnail", "pixel_masks", "fingerprint_file", "fixed_region_masks",
        "variable_region_masks", "security_element_regions", "precomputed_fingerprint"
      ],
      "allOf": [
        {
          "if": { "properties": { "source_class": { "const": "synthetic_demo" } } },
          "then": {
            "properties": {
              "trust_level": { "const": "P0" },
              "demonstration_only": { "const": true },
              "source_url": { "type": "null" }
            }
          }
        }
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "profile_id": { "$ref": "#/$defs/id" },
        "exemplar_id": { "$ref": "#/$defs/id" },
        "document_page_number": { "type": "integer", "minimum": 1, "maximum": 10 },
        "asset_page_number": { "type": "integer", "minimum": 1, "maximum": 10 },
        "side": { "enum": ["front", "back", "interior", "unspecified"] },
        "relative_path": { "$ref": "#/$defs/assetPath" },
        "mime_type": { "enum": ["application/pdf", "image/png", "image/jpeg"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["points", "pixels"] }
          }
        },
        "source_class": {
          "enum": [
            "synthetic_demo", "authorized_official_specimen",
            "authorized_organization_template", "user_registered_trusted_reference",
            "derived_from_multiple_trusted_exemplars"
          ]
        },
        "issuer": { "$ref": "#/$defs/text" },
        "document_family": { "$ref": "#/$defs/id" },
        "profile_version": { "$ref": "#/$defs/text" },
        "languages": { "$ref": "#/$defs/textArrayNonEmpty" },
        "creation_method": { "$ref": "#/$defs/text" },
        "source_url": { "type": ["string", "null"], "format": "uri", "maxLength": 4000 },
        "retrieval_date": { "type": "string", "format": "date" },
        "redistribution_status": {
          "enum": ["permitted", "not_permitted", "unclear", "not_applicable"]
        },
        "trust_level": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
        "licence_status_note": { "$ref": "#/$defs/text" },
        "may_influence_tampering_risk": { "type": "boolean" },
        "demonstration_only": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "thumbnail": { "$ref": "#/$defs/binaryAssetDescriptor" },
        "pixel_masks": {
          "type": "object", "additionalProperties": false,
          "required": ["fixed", "variable", "security"],
          "properties": {
            "fixed": { "$ref": "#/$defs/binaryAssetDescriptor" },
            "variable": { "$ref": "#/$defs/binaryAssetDescriptor" },
            "security": { "$ref": "#/$defs/binaryAssetDescriptor" }
          }
        },
        "fingerprint_file": { "$ref": "#/$defs/fingerprintFileDescriptor" },
        "fixed_region_masks": { "$ref": "#/$defs/regionsNonEmpty" },
        "variable_region_masks": { "$ref": "#/$defs/regions" },
        "security_element_regions": { "$ref": "#/$defs/securityElementRegions" },
        "precomputed_fingerprint": {
          "type": "object", "additionalProperties": false,
          "required": [
            "algorithm", "version", "render_max_edge", "source_sha256",
            "mask_sha256", "value", "edge_phash", "layout_sha256",
            "border_sha256", "security_geometry_sha256",
            "stable_anchor_geometry_sha256", "aspect_ratio",
            "colour_histogram", "fixed_region_hashes"
          ],
          "properties": {
            "algorithm": { "const": "docuverify-visual-fingerprint-v2" },
            "version": { "const": "2.0.0" },
            "render_max_edge": { "type": "integer", "minimum": 256, "maximum": 4096 },
            "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "value": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "edge_phash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "mask_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "layout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "border_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "security_geometry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "stable_anchor_geometry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "aspect_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
            "colour_histogram": {
              "type": "array", "minItems": 24, "maxItems": 24,
              "items": { "type": "integer", "minimum": 0, "maximum": 10000 }
            },
            "fixed_region_hashes": {
              "type": "object", "minProperties": 1, "maxProperties": 80,
              "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
            }
          }
        }
      }
    }
  }
}
